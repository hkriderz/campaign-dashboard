# Copy to .env.local (dev) or set in Dokploy environment variables (production).

# ─── Google BigQuery ───────────────────────────────────────────────────────────
# Option A: path to service account JSON (relative to project root or absolute)
# GOOGLE_APPLICATION_CREDENTIALS=credentials/gcp-service-account.json

# Option B (Docker/VPS): paste full JSON or base64-encoded JSON — written at startup
# GCP_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

GCP_PROJECT_ID=your-gcp-project-id
BQ_DATASET=l11_stw
# Scale to Win Text (support-tag dashboard at /texting)
# BQ_TEXT_DATASET=l11_stw_txt

# ─── Optional: persistent data directory (mount a volume here on Dokploy) ───
# CAMPAIGN_DASHBOARD_DATA_DIR=/app

# ─── BQ snapshot cache ───────────────────────────────────────────────────────
# BQ_MONTHLY_BUDGET_USD=50
# List price used for the spend meter. Default is 6.25 dollars per TiB.
# BQ_USD_PER_TIB=6.25

# CAMPAIGN_DASHBOARD_SNAPSHOT_SECRET=your-long-random-string
# BQ_SNAPSHOTS_DISABLED=1
# CAMPAIGN_DASHBOARD_BQ_CACHE_SECONDS=45
# CAMPAIGN_DASHBOARD_MERGED_BQ_CACHE_SECONDS=120

# ─── PDI Tools (optional — or upload one bundle / separate files in the UI) ───
# Bundle shape: credentials/campaign-credentials.example.json ({ "gcp": {...}, "pdi": {...} })
# PDI_USERNAME=
# PDI_PASSWORD=
# PDI_API_TOKEN=
# PDI_TOOLS_DATA_DIR=/path/to/ndjson-folder
# PDI_SYNC_ENGINE=typescript
# Optional overrides if PDI Admin renames/recreates acquisition types
# PDI_DIALER_ACQUISITION_TYPE_ID=
# PDI_TEXT_ACQUISITION_TYPE_ID=

# ─── Session credentials (multi-user Dokploy deploy) ─────────────────────────
# When enabled, each browser must upload its own GCP/PDI keys before seeing data.
# CAMPAIGN_DASHBOARD_SESSION_CREDENTIALS=1
# (also accepts true, yes, on — not just the digit 1)
# Cookie Secure flag defaults to OFF (works on HTTP). Set to 1 only when the site is HTTPS.
# CAMPAIGN_DASHBOARD_SESSION_COOKIE_SECURE=1
# CAMPAIGN_DASHBOARD_ALLOW_GLOBAL_CREDENTIALS=1
# CAMPAIGN_DASHBOARD_SESSION_CREDENTIALS_TTL_HOURS=72

# ─── Staff logins (required in production) ────────────────────────────────────
# Signs the HttpOnly login cookie. Use a long random value on the VPS.
# Local next dev falls back to a built-in dev secret when this is unset.
# CAMPAIGN_DASHBOARD_AUTH_SECRET=
# First boot only, when data/auth/users.json has no accounts: creates the superadmin.
# CAMPAIGN_DASHBOARD_ADMIN_LOGIN=
# CAMPAIGN_DASHBOARD_ADMIN_PASSWORD=
# On HTTPS set CAMPAIGN_DASHBOARD_SESSION_COOKIE_SECURE=1 (see session section above).

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
HOSTNAME=0.0.0.0
